# Server
PORT=4000
NODE_ENV=development # development | production | test

# Database — chọn 1 trong 2:
# Cloud (Neon):  postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require
# Docker local:  postgresql://eventhub:eventhub_password@postgres:5432/eventhub
#               (khi chạy docker compose, compose tự set, không cần điền)
DATABASE_URL=""

# Redis — chọn 1 trong 2:
# Cloud (Upstash): rediss://default:xxx@xxx.upstash.io:6379
# Docker local:    redis://redis:6379
REDIS_URL=""

# RabbitMQ — chọn 1 trong 2:
# Cloud (CloudAMQP): amqps://user:pass@fuji.lmq.cloudamqp.com/vhost
# Docker local:      amqp://guest:guest@rabbitmq:5672
RABBITMQ_URL=""

# JWT — tự tạo 2 chuỗi khác nhau, mỗi chuỗi ≥32 ký tự
# Gợi ý tạo nhanh: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Gmail — dùng để gửi mail verify/reset + vé QR
GMAIL_USER=""              # vd: your@gmail.com
GMAIL_APP_PASSWORD=""      # App Password 16 ký tự (Google Account → App passwords)

# Gmail REST API (HTTPS 443, không bị Render chặn) — có đủ 3 thì dùng REST, thiếu thì fallback SMTP
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
GMAIL_REFRESH_TOKEN=""

# Cloudinary — upload ảnh bìa sự kiện (https://cloudinary.com)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Frontend — để tạo link trong email và CORS
FRONTEND_URL="http://localhost:5173"  # local Vite: 5173, Docker: http://localhost:8080, prod: https://eventhub-rosy.vercel.app
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:8080"

# Tuning (có mặc định, không cần sửa)
RATE_LIMIT_MAX=600
HOLD_CLEANUP_INTERVAL_MS=43200000
